# Doxyfile for fcpp-leases, Italian documentation (doxygen 1.9.6 - 1.14, theme doxygen-awesome-css v2.3.4).
# Doxyfile.en includes this file and overrides the language-dependent options.
# Only the options that differ from the defaults are listed.
# Build both languages with ./build.sh  ->  build/html/index.html

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = fcpp-leases
PROJECT_BRIEF          = "Field-Based Leases"
OUTPUT_DIRECTORY       = build
OUTPUT_LANGUAGE        = Italian
STRIP_FROM_PATH        = ..
STRIP_FROM_INC_PATH    = ..
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
HIDE_UNDOC_RELATIONS   = YES
SHOW_INCLUDE_FILES     = YES
SORT_MEMBER_DOCS       = NO
# implementation details (namespace details, @cond INTERNAL) stay out of the docs
EXCLUDE_SYMBOLS        = details details::*

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = pages/it ../lib
FILE_PATTERNS          = *.hpp *.md *.dox
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = pages/it/mainpage.md
IMAGE_PATH             = pages/it
EXAMPLE_PATH           = pages/it/figures

#---------------------------------------------------------------------------
# Preprocessor: expand the FCPP macros used in the signatures
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
SEARCH_INCLUDES        = NO
PREDEFINED             = "ARGS=node_t& node, trace_t call_point" \
                         "CODE=" \
                         "CALL=node, call_point" \
                         "FUN=template <typename node_t>" \
                         "FUN_EXPORT=using"

#---------------------------------------------------------------------------
# Sources in the docs (useful for code review)
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# HTML with doxygen-awesome-css, light theme, green accent
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html/it
HTML_HEADER            = header.html
HTML_EXTRA_STYLESHEET  = doxygen-awesome-css/doxygen-awesome.css \
                         fcpp-leases.css
HTML_EXTRA_FILES       = doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
                         doxygen-awesome-css/doxygen-awesome-paragraph-link.js \
                         doxygen-awesome-css/doxygen-awesome-interactive-toc.js
HTML_COLORSTYLE        = LIGHT
HTML_COPY_CLIPBOARD    = NO
HTML_DYNAMIC_SECTIONS  = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
TREEVIEW_WIDTH         = 300
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# Nothing else
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
HAVE_DOT               = NO
CLASS_GRAPH            = NO
COLLABORATION_GRAPH    = NO
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
WARN_IF_INCOMPLETE_DOC = NO
WARN_LOGFILE           = doxygen-warnings-it.log
QUIET                  = YES
